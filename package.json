{
  "name": "woolworths-cli",
  "version": "1.1.0",
  "description": "CLI and Node.js client for Woolworths Dash on-demand grocery delivery (South Africa), reverse-engineered from the Android app. Search products, manage your cart, and walk checkout up to 3DS payment.",
  "keywords": [
    "woolworths",
    "woolworths-dash",
    "dash",
    "grocery",
    "delivery",
    "south-africa",
    "cli",
    "wfs"
  ],
  "homepage": "https://github.com/yashiels/woolworths-cli#readme",
  "bugs": {
    "url": "https://github.com/yashiels/woolworths-cli/issues"
  },
  "license": "MIT",
  "author": "Yashiel Sookdeo <yashiel@skyner.co.za>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashiels/woolworths-cli.git"
  },
  "main": "lib/api-client.js",
  "bin": {
    "woolies": "./bin/woolies.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node --check lib/api-client.js && node --check bin/woolies.js",
    "test": "node test/smoke.test.js",
    "fmt": "npx prettier --write .",
    "start": "node bin/woolies.js"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "prettier": "^3.8.4"
  }
}
